# ============================================
# Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file - it's in .gitignore for security

# ============================================
# Cloudinary Configuration
# ============================================
# Get these from your Cloudinary dashboard: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ============================================
# Database Configuration (Optional for production)
# ============================================
# DB_URL=jdbc:postgresql://localhost:5432/findjob
# DB_USERNAME=postgres
# DB_PASSWORD=your_password_here

# ============================================
# Email Configuration (Optional)
# ============================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_email_password

# ============================================
# JWT Configuration (Optional)
# ============================================
# JWT_SECRET=your_jwt_secret_key_here
